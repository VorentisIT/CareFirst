---
import { withBase } from "@lib/urls";
import siteConfig from "../../siteConfig";
import Container from "@ui/Container.astro";
import Button from "@ui/Button.astro";
import Logo from "@ui/Logo.astro";
import Burger from "@ui/Burger.astro";
import { Icon } from "astro-icon/components";

const servicesList = [
	{ title: "Cardiology", url: "/services/cardiology" },
	{ title: "Neurology", url: "/services/neurology" },
	{ title: "Pediatrics", url: "/services/pediatric" },
	{ title: "Orthopedics", url: "/services/orthopedics" },
	{ title: "Radiology", url: "/services/radiology" },
	{ title: "Laboratory", url: "/services/laboratory" },
];
---

<header class="header" id="header">
	<Container>
		<Logo />

		<nav class="header-nav" id="header-nav" aria-label="Main Navigation">
			<ul class="main-menu">
				{
					siteConfig.nav.main.map((item) => {
						const isServices = item.url === "/services" || item.text.toLowerCase() === "services";

						if (isServices) {
							return (
								<li class="main-menu__item main-menu__item--has-dropdown" id="services-nav-item">
									<div class="services-link-wrapper">
										<a href={withBase(item.url)} class="main-menu__link main-menu__link--services">
											<span>{item.text}</span>
											<Icon name="chevron-down" class="nav-chevron nav-chevron--desktop" aria-hidden="true" />
										</a>
										<button
											type="button"
											class="services-expand-btn"
											id="services-expand-btn"
											aria-expanded="false"
											aria-controls="services-dropdown"
											aria-label="Toggle services list"
										>
											<Icon name="chevron-down" class="nav-chevron nav-chevron--mobile" aria-hidden="true" />
										</button>
									</div>

									<div class="services-dropdown" id="services-dropdown" aria-label="Services Submenu">
										<ul class="services-dropdown__list">
											{servicesList.map((svc) => (
												<li>
													<a href={withBase(svc.url)} class="dropdown-item">
														{svc.title}
													</a>
												</li>
											))}
										</ul>
									</div>
								</li>
							);
						}

						return (
							<li class="main-menu__item">
								<a href={withBase(item.url)} class="main-menu__link">
									{item.text}
								</a>
							</li>
						);
					})
				}
			</ul>

			<!-- Drawer Actions & Emergency Contact for Mobile -->
			<div class="mobile-drawer-footer">
				<Button href={withBase("/appointment")} color="primary" variant="solid" class="mobile-cta-btn">
					Book Appointment
				</Button>

				<div class="mobile-contact-card">
					<div class="mobile-contact-card__header">
						<span class="contact-card__tag">Emergency Care 24/7</span>
					</div>
					<div class="mobile-contact-card__body">
						<a href="tel:+916239796319" class="contact-card__val">
							<Icon name="phone" class="contact-icon" aria-hidden="true" />
							+91 62397 96319
						</a>
						<span class="contact-card__sub">Gill Road, Civil Lines, Ludhiana</span>
					</div>
				</div>
			</div>
		</nav>

		<Burger />
	</Container>
</header>

<script>
	const body = document.body;
	const header = document.getElementById("header");
	const burger = document.querySelector(".menu-burger");
	const servicesItem = document.getElementById("services-nav-item");
	const servicesExpandBtn = document.getElementById("services-expand-btn");

	// Header sticky shadow on scroll
	if (header) {
		const onScroll = () => {
			header.classList.toggle("header--scrolled", body.scrollTop > 10);
		};
		onScroll();
		body.addEventListener("scroll", onScroll, { passive: true });
	}

	// Close mobile drawer helper
	const closeMobileMenu = () => {
		body.classList.remove("menu-open");
		burger?.classList.remove("menu-burger--opened");
		burger?.setAttribute("aria-expanded", "false");
		burger?.setAttribute("aria-label", "Open navigation menu");
	};

	// Close mobile menu when any navigation link is clicked
	const navLinks = document.querySelectorAll(".header-nav a");
	navLinks.forEach((link) => {
		link.addEventListener("click", () => {
			if (body.classList.contains("menu-open")) {
				closeMobileMenu();
			}
		});
	});

	// Mobile Services Accordion Toggle
	if (servicesExpandBtn && servicesItem) {
		servicesExpandBtn.addEventListener("click", (e) => {
			e.preventDefault();
			e.stopPropagation();
			const isExpanded = servicesExpandBtn.getAttribute("aria-expanded") === "true";
			servicesExpandBtn.setAttribute("aria-expanded", String(!isExpanded));
			servicesItem.classList.toggle("main-menu__item--expanded", !isExpanded);
		});
	}
</script>

<style>
	.header {
		z-index: 2000;
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		padding: 0 2.4rem;
		height: var(--header-height);
		background: #ffffff;
		border-bottom: 1px solid rgba(15, 23, 42, 0.06);
		transition: all 0.25s ease;

		&.header--scrolled {
			--header-height: 6.4rem;
			position: fixed;
			background: rgba(255, 255, 255, 0.94);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
			border-bottom: 1px solid rgba(15, 23, 42, 0.08);
		}

		.container {
			display: flex;
			height: 100%;
			flex: 1 0 100%;
			align-items: center;
			justify-content: space-between;
		}
	}

	.header-nav {
		display: flex;
		flex-grow: 1;
		justify-content: flex-end;
		align-items: center;

		/* Mobile Full-Screen Clean Menu */
		@media screen and (max-width: 1024px) {
			z-index: 1999;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			width: 100vw;
			width: 100%;
			height: 100vh;
			height: 100dvh;
			flex-direction: column;
			align-items: stretch;
			justify-content: flex-start;
			background-color: #ffffff;
			transform: translateX(100%);
			visibility: hidden;
			transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
			overflow-y: auto;
			-webkit-overflow-scrolling: touch;
			padding: calc(var(--header-height) + 1.2rem) 2.4rem 4rem;

			body.menu-open & {
				transform: translateX(0);
				visibility: visible;
			}
		}
	}

	.main-menu {
		display: flex;
		margin-inline: auto;
		gap: 0.8rem;
		align-items: center;

		@media screen and (max-width: 1024px) {
			margin-inline: 0;
			margin-bottom: 2.8rem;
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			gap: 0.2rem;
		}
	}

	.main-menu__item {
		position: relative;

		@media screen and (max-width: 1024px) {
			width: 100%;
			border-bottom: 1px solid rgba(15, 23, 42, 0.06);
		}
	}

	.services-link-wrapper {
		display: inline-flex;
		align-items: center;

		@media screen and (max-width: 1024px) {
			display: flex;
			width: 100%;
			justify-content: space-between;
			align-items: center;
		}
	}

	.main-menu__link {
		color: #334155;
		font-size: 1.5rem;
		font-weight: 600;
		text-decoration: none;
		padding: 0.8rem 1.6rem;
		border-radius: 9999px;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		transition: all 0.18s ease;

		&:hover {
			color: var(--color-primary);
			background-color: #f1f5f9;
		}

		@media screen and (max-width: 1024px) {
			font-size: 1.8rem;
			font-weight: 600;
			padding: 1.4rem 0.6rem;
			width: auto;
			border-radius: 0;
			color: #0f172a;

			&:hover {
				background: transparent;
				color: var(--color-primary);
			}
		}
	}

	.nav-chevron {
		transition: transform 0.2s ease, color 0.2s ease;

		&.nav-chevron--desktop {
			width: 1.2rem;
			height: 1.2rem;
			color: #64748b;

			@media screen and (max-width: 1024px) {
				display: none;
			}
		}

		&.nav-chevron--mobile {
			width: 1.6rem;
			height: 1.6rem;
			color: #64748b;
		}
	}

	.services-expand-btn {
		display: none;

		@media screen and (max-width: 1024px) {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			background: transparent;
			border: none;
			padding: 1rem;
			cursor: pointer;
		}
	}

	/* Desktop Hover Expand */
	@media screen and (min-width: 1025px) {
		.main-menu__item--has-dropdown:hover .nav-chevron--desktop,
		.main-menu__item--has-dropdown:focus-within .nav-chevron--desktop {
			transform: rotate(180deg);
			color: var(--color-primary);
		}

		.main-menu__item--has-dropdown:hover .services-dropdown,
		.main-menu__item--has-dropdown:focus-within .services-dropdown {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: translateX(-50%) translateY(0);
		}
	}

	/* Mobile Accordion Expand */
	@media screen and (max-width: 1024px) {
		.main-menu__item--expanded .nav-chevron--mobile {
			transform: rotate(180deg);
			color: var(--color-primary);
		}

		.main-menu__item--expanded .services-dropdown {
			display: block;
			max-height: 40rem;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
		}
	}

	/* Simple, Clean Services Dropdown */
	.services-dropdown {
		position: absolute;
		top: calc(100% + 0.8rem);
		left: 50%;
		transform: translateX(-50%) translateY(6px);
		width: 22rem;
		padding: 0.8rem;
		background: #ffffff;
		border-radius: 1.4rem;
		border: 1px solid rgba(15, 23, 42, 0.08);
		box-shadow: 0 16px 36px -4px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(15, 23, 42, 0.04);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
		z-index: 2100;

		&::before {
			content: "";
			position: absolute;
			top: -1.2rem;
			left: 0;
			right: 0;
			height: 1.2rem;
		}

		@media screen and (max-width: 1024px) {
			display: none;
			position: static;
			transform: none;
			width: 100%;
			max-height: 0;
			padding: 0.4rem 0 0.8rem 1.6rem;
			margin: 0;
			background: transparent;
			border: none;
			border-left: 2px solid #e2e8f0;
			border-radius: 0;
			box-shadow: none;
			transition: max-height 0.25s ease;
			overflow: hidden;

			&::before {
				display: none;
			}
		}
	}

	.services-dropdown__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.dropdown-item {
		display: block;
		padding: 0.9rem 1.4rem;
		font-size: 1.45rem;
		font-weight: 500;
		color: #334155;
		text-decoration: none;
		border-radius: 0.8rem;
		transition: background-color 0.15s ease, color 0.15s ease, padding-left 0.15s ease;

		&:hover {
			background-color: #f1f5f9;
			color: var(--color-primary);
			padding-left: 1.8rem;
		}

		@media screen and (max-width: 1024px) {
			padding: 1rem 1.2rem;
			font-size: 1.6rem;
			border-radius: 0.8rem;

			&:hover,
			&:active {
				background-color: #f1f5f9;
				color: var(--color-primary);
				padding-left: 1.2rem;
			}
		}
	}

	/* Drawer Footer on Mobile */
	.mobile-drawer-footer {
		display: none;

		@media screen and (max-width: 1024px) {
			display: flex;
			flex-direction: column;
			gap: 1.6rem;
			width: 100%;
			margin-top: auto;
			padding-top: 2rem;

			:global(.mobile-cta-btn) {
				width: 100%;
				justify-content: center;
				padding: 1.4rem;
				font-size: 1.55rem;
				font-weight: 700;
				border-radius: 1.2rem;
				box-shadow: 0 4px 14px rgba(29, 84, 199, 0.25);
			}
		}
	}

	.mobile-contact-card {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		padding: 1.6rem;
		background: #f8fafc;
		border-radius: 1.4rem;
		border: 1px solid rgba(15, 23, 42, 0.06);

		.mobile-contact-card__header {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.contact-card__tag {
			font-size: 1.1rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: #0d9488;
		}

		.mobile-contact-card__body {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
		}

		.contact-card__val {
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			font-size: 1.5rem;
			font-weight: 700;
			color: #0f172a;
			text-decoration: none;

			&:hover {
				color: var(--color-primary);
			}

			.contact-icon {
				width: 1.4rem;
				height: 1.4rem;
				color: var(--color-primary);
			}
		}

		.contact-card__sub {
			font-size: 1.25rem;
			color: #64748b;
		}
	}

	/* Hide Drawer Footer on Desktop */
	@media screen and (min-width: 1025px) {
		.mobile-drawer-footer {
			display: none !important;
		}
	}
</style>
