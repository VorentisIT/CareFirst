---
import { withBase } from "@lib/urls";
import siteConfig from "../../siteConfig";
import Container from "@ui/Container.astro";
import Button from "@ui/Button.astro";
import Logo from "@ui/Logo.astro";
import Burger from "@ui/Burger.astro";
import { Icon } from "astro-icon/components";

const servicesList = [
	{
		title: "Cardiology",
		desc: "Heart & vascular diagnostics",
		url: "/services/cardiology",
		icon: "cardio",
	},
	{
		title: "Neurology",
		desc: "Brain, spine & nervous system",
		url: "/services/neurology",
		icon: "brain",
	},
	{
		title: "Pediatrics",
		desc: "Specialized child & infant care",
		url: "/services/pediatric",
		icon: "stetoscope",
	},
	{
		title: "Orthopedics",
		desc: "Bones, joints & spine treatments",
		url: "/services/orthopedics",
		icon: "bones",
	},
	{
		title: "Radiology",
		desc: "Digital X-Ray, CT & MRI scans",
		url: "/services/radiology",
		icon: "eye",
	},
	{
		title: "Laboratory",
		desc: "Clinical pathology & testing",
		url: "/services/laboratory",
		icon: "microscope",
	},
];
---

<header class="header" id="header">
	<Container>
		<Logo />

		<nav class="header-nav" id="header-nav" aria-label="Main Navigation">
			<ul class="main-menu">
				{
					siteConfig.nav.main.map((item) => {
						const isServices = item.url === "/services" || item.text.toLowerCase() === "services";

						if (isServices) {
							return (
								<li class="main-menu__item main-menu__item--has-dropdown" id="services-nav-item">
									<div class="services-link-wrapper">
										<a href={withBase(item.url)} class="main-menu__link main-menu__link--services">
											<span>{item.text}</span>
											<Icon name="chevron-down" class="nav-chevron nav-chevron--desktop" aria-hidden="true" />
										</a>
										<button
											type="button"
											class="services-expand-btn"
											id="services-expand-btn"
											aria-expanded="false"
											aria-controls="services-dropdown"
											aria-label="Toggle medical specialties submenu"
										>
											<Icon name="chevron-down" class="nav-chevron nav-chevron--mobile" aria-hidden="true" />
										</button>
									</div>

									<div class="services-dropdown" id="services-dropdown" aria-label="Medical Specialties Submenu">
										<div class="services-dropdown__header">
											<div class="dropdown-header-left">
												<span class="pulse-dot" aria-hidden="true"></span>
												<span class="dropdown-badge">Medical Specialties</span>
											</div>
											<a href={withBase("/services")} class="dropdown-view-all">
												Explore All Departments <Icon name="arrow-right" class="arrow-icon" aria-hidden="true" />
											</a>
										</div>

										<div class="services-dropdown__grid">
											{servicesList.map((svc) => (
												<a href={withBase(svc.url)} class="dropdown-item">
													<span class="dropdown-item__icon" aria-hidden="true">
														<Icon name={svc.icon} />
													</span>
													<div class="dropdown-item__content">
														<strong class="dropdown-item__title">{svc.title}</strong>
														<span class="dropdown-item__desc">{svc.desc}</span>
													</div>
												</a>
											))}
										</div>
									</div>
								</li>
							);
						}

						return (
							<li class="main-menu__item">
								<a href={withBase(item.url)} class="main-menu__link">
									{item.text}
								</a>
							</li>
						);
					})
				}
			</ul>

			<!-- Drawer Actions & Emergency Contact for Mobile -->
			<div class="mobile-drawer-footer">
				<Button href={withBase("/appointment")} color="primary" variant="solid" class="mobile-cta-btn">
					Book Appointment
				</Button>

				<div class="mobile-contact-card">
					<div class="mobile-contact-card__header">
						<span class="contact-card__tag">Emergency Care 24/7</span>
					</div>
					<div class="mobile-contact-card__body">
						<a href="tel:+916239796319" class="contact-card__val">
							<Icon name="phone" class="contact-icon" aria-hidden="true" />
							+91 62397 96319
						</a>
						<span class="contact-card__sub">Gill Road, Civil Lines, Ludhiana</span>
					</div>
				</div>
			</div>
		</nav>

		<Burger />
	</Container>
</header>

<script>
	const body = document.body;
	const header = document.getElementById("header");
	const burger = document.querySelector(".menu-burger");
	const servicesItem = document.getElementById("services-nav-item");
	const servicesExpandBtn = document.getElementById("services-expand-btn");

	// Header sticky shadow on scroll
	if (header) {
		const onScroll = () => {
			header.classList.toggle("header--scrolled", body.scrollTop > 10);
		};
		onScroll();
		body.addEventListener("scroll", onScroll, { passive: true });
	}

	// Close mobile drawer helper
	const closeMobileMenu = () => {
		body.classList.remove("menu-open");
		burger?.classList.remove("menu-burger--opened");
		burger?.setAttribute("aria-expanded", "false");
		burger?.setAttribute("aria-label", "Open navigation menu");
	};

	// Close mobile menu when any navigation link is clicked
	const navLinks = document.querySelectorAll(".header-nav a");
	navLinks.forEach((link) => {
		link.addEventListener("click", () => {
			if (body.classList.contains("menu-open")) {
				closeMobileMenu();
			}
		});
	});

	// Mobile Services Accordion Toggle
	if (servicesExpandBtn && servicesItem) {
		servicesExpandBtn.addEventListener("click", (e) => {
			e.preventDefault();
			e.stopPropagation();
			const isExpanded = servicesExpandBtn.getAttribute("aria-expanded") === "true";
			servicesExpandBtn.setAttribute("aria-expanded", String(!isExpanded));
			servicesItem.classList.toggle("main-menu__item--expanded", !isExpanded);
		});
	}
</script>

<style>
	.header {
		z-index: 2000;
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		padding: 0 2.4rem;
		height: var(--header-height);
		background: #ffffff;
		border-bottom: 1px solid rgba(15, 23, 42, 0.06);
		transition: all 0.25s ease;

		&.header--scrolled {
			--header-height: 6.4rem;
			position: fixed;
			background: rgba(255, 255, 255, 0.94);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
			border-bottom: 1px solid rgba(15, 23, 42, 0.08);
		}

		.container {
			display: flex;
			height: 100%;
			flex: 1 0 100%;
			align-items: center;
			justify-content: space-between;
		}
	}

	.header-nav {
		display: flex;
		flex-grow: 1;
		justify-content: flex-end;
		align-items: center;

		/* Mobile Full-Screen Clean Menu */
		@media screen and (max-width: 1024px) {
			z-index: 1999;
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			width: 100vw;
			width: 100%;
			height: 100vh;
			height: 100dvh;
			flex-direction: column;
			align-items: stretch;
			justify-content: flex-start;
			background-color: #ffffff;
			transform: translateX(100%);
			visibility: hidden;
			transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.35s ease;
			overflow-y: auto;
			-webkit-overflow-scrolling: touch;
			padding: calc(var(--header-height) + 1.2rem) 2.4rem 4rem;

			body.menu-open & {
				transform: translateX(0);
				visibility: visible;
			}
		}
	}

	.main-menu {
		display: flex;
		margin-inline: auto;
		gap: 0.8rem;
		align-items: center;

		@media screen and (max-width: 1024px) {
			margin-inline: 0;
			margin-bottom: 2.8rem;
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			gap: 0.2rem;
		}
	}

	.main-menu__item {
		position: relative;

		@media screen and (max-width: 1024px) {
			width: 100%;
			border-bottom: 1px solid rgba(15, 23, 42, 0.06);
		}
	}

	.services-link-wrapper {
		display: inline-flex;
		align-items: center;

		@media screen and (max-width: 1024px) {
			display: flex;
			width: 100%;
			justify-content: space-between;
			align-items: center;
		}
	}

	.main-menu__link {
		color: #334155;
		font-size: 1.5rem;
		font-weight: 600;
		text-decoration: none;
		padding: 0.8rem 1.6rem;
		border-radius: 9999px;
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		transition: all 0.18s ease;

		&:hover {
			color: var(--color-primary);
			background-color: #f1f5f9;
		}

		@media screen and (max-width: 1024px) {
			font-size: 1.8rem;
			font-weight: 600;
			padding: 1.4rem 0.6rem;
			width: auto;
			border-radius: 0;
			color: #0f172a;

			&:hover {
				background: transparent;
				color: var(--color-primary);
			}
		}
	}

	.nav-chevron {
		transition: transform 0.2s ease, color 0.2s ease;

		&.nav-chevron--desktop {
			width: 1.2rem;
			height: 1.2rem;
			color: #64748b;

			@media screen and (max-width: 1024px) {
				display: none;
			}
		}

		&.nav-chevron--mobile {
			width: 1.6rem;
			height: 1.6rem;
			color: #64748b;
		}
	}

	.services-expand-btn {
		display: none;

		@media screen and (max-width: 1024px) {
			display: inline-flex;
			align-items: center;
			gap: 0.8rem;
			background: transparent;
			border: none;
			padding: 0.8rem;
			cursor: pointer;
		}
	}

	.mobile-services-badge {
		font-size: 1.15rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.3rem 0.8rem;
		border-radius: 9999px;
		background: #eef2ff;
		color: var(--color-primary);
	}

	/* Desktop Hover Expand */
	@media screen and (min-width: 1025px) {
		.main-menu__item--has-dropdown:hover .nav-chevron--desktop,
		.main-menu__item--has-dropdown:focus-within .nav-chevron--desktop {
			transform: rotate(180deg);
			color: var(--color-primary);
		}

		.main-menu__item--has-dropdown:hover .services-dropdown,
		.main-menu__item--has-dropdown:focus-within .services-dropdown {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: translateX(-50%) translateY(0);
		}
	}

	/* Mobile Accordion Expand */
	@media screen and (max-width: 1024px) {
		.main-menu__item--expanded .nav-chevron--mobile {
			transform: rotate(180deg);
			color: var(--color-primary);
		}

		.main-menu__item--expanded .services-dropdown {
			display: block;
			max-height: 80rem;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
		}
	}

	/* Services Dropdown - Desktop Elevated Card */
	.services-dropdown {
		position: absolute;
		top: calc(100% + 1.2rem);
		left: 50%;
		transform: translateX(-50%) translateY(10px);
		width: 60rem;
		padding: 2rem;
		background: #ffffff;
		border-radius: 2rem;
		border: 1px solid rgba(15, 23, 42, 0.07);
		box-shadow: 0 24px 50px -12px rgba(15, 23, 42, 0.14), 0 0 0 1px rgba(15, 23, 42, 0.04);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s ease;
		z-index: 2100;

		&::before {
			content: "";
			position: absolute;
			top: -1.6rem;
			left: 0;
			right: 0;
			height: 1.6rem;
		}

		@media screen and (max-width: 1024px) {
			display: none;
			position: static;
			transform: none;
			width: 100%;
			max-height: 0;
			padding: 0.4rem 0 0.8rem 1.6rem;
			margin: 0;
			background: transparent;
			border: none;
			border-left: 2px solid #e2e8f0;
			border-radius: 0;
			box-shadow: none;
			transition: max-height 0.25s ease;
			overflow: hidden;

			&::before {
				display: none;
			}
		}
	}

	.services-dropdown__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 1.2rem;
		margin-bottom: 1.2rem;
		border-bottom: 1px solid rgba(15, 23, 42, 0.06);

		@media screen and (max-width: 1024px) {
			display: none;
		}
	}

	.dropdown-header-left {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}

	.pulse-dot {
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 9999px;
		background: var(--color-primary);
		box-shadow: 0 0 0 3px rgba(29, 84, 199, 0.18);
	}

	.dropdown-badge {
		font-size: 1.2rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #475569;
	}

	.dropdown-view-all {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-primary);
		text-decoration: none;
		transition: all 0.15s ease;

		&:hover {
			color: var(--color-primary-dark);
			gap: 0.7rem;
		}

		.arrow-icon {
			width: 1.2rem;
			height: 1.2rem;
		}
	}

	.services-dropdown__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.8rem;

		@media screen and (max-width: 1024px) {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
		}
	}

	.dropdown-item {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		padding: 1rem 1.2rem;
		border-radius: 1.4rem;
		border: 1px solid transparent;
		text-decoration: none;
		transition: background-color 0.18s ease, transform 0.18s ease, border-color 0.18s ease;

		&:hover {
			background-color: #f8fafc;
			border-color: rgba(29, 84, 199, 0.10);
			transform: translateY(-1px);

			.dropdown-item__icon {
				background-color: var(--color-primary);
				color: #ffffff;
				box-shadow: 0 4px 12px rgba(29, 84, 199, 0.22);
			}

			.dropdown-item__title {
				color: var(--color-primary);
			}
		}

		@media screen and (max-width: 1024px) {
			padding: 1rem 1.2rem;
			background: transparent;
			border: none;
			border-radius: 0.8rem;

			&:hover,
			&:active {
				background-color: #f1f5f9;
				transform: none;

				.dropdown-item__title {
					color: var(--color-primary);
				}
			}
		}
	}

	.dropdown-item__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 4rem;
		height: 4rem;
		flex-shrink: 0;
		border-radius: 1.2rem;
		background: #eef2ff;
		color: var(--color-primary);
		transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;

		:global(svg) {
			width: 2rem;
			height: 2rem;
		}

		@media screen and (max-width: 1024px) {
			display: none;
		}
	}

	.dropdown-item__content {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.dropdown-item__title {
		font-size: 1.45rem;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.2;
		transition: color 0.15s ease;

		@media screen and (max-width: 1024px) {
			font-size: 1.6rem;
			font-weight: 500;
			color: #334155;
		}
	}

	.dropdown-item__desc {
		font-size: 1.2rem;
		color: #64748b;
		line-height: 1.35;

		@media screen and (max-width: 1024px) {
			display: none;
		}
	}

	/* Drawer Footer on Mobile */
	.mobile-drawer-footer {
		display: none;

		@media screen and (max-width: 1024px) {
			display: flex;
			flex-direction: column;
			gap: 1.6rem;
			width: 100%;
			margin-top: auto;
			padding-top: 2rem;

			:global(.mobile-cta-btn) {
				width: 100%;
				justify-content: center;
				padding: 1.4rem;
				font-size: 1.55rem;
				font-weight: 700;
				border-radius: 1.2rem;
				box-shadow: 0 4px 14px rgba(29, 84, 199, 0.25);
			}
		}
	}

	.mobile-contact-card {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		padding: 1.6rem;
		background: #f8fafc;
		border-radius: 1.4rem;
		border: 1px solid rgba(15, 23, 42, 0.06);

		.mobile-contact-card__header {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.contact-card__tag {
			font-size: 1.1rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: #0d9488;
		}

		.mobile-contact-card__body {
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
		}

		.contact-card__val {
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			font-size: 1.5rem;
			font-weight: 700;
			color: #0f172a;
			text-decoration: none;

			&:hover {
				color: var(--color-primary);
			}

			.contact-icon {
				width: 1.4rem;
				height: 1.4rem;
				color: var(--color-primary);
			}
		}

		.contact-card__sub {
			font-size: 1.25rem;
			color: #64748b;
		}
	}

	/* Hide Drawer Footer on Desktop */
	@media screen and (min-width: 1025px) {
		.mobile-drawer-footer {
			display: none !important;
		}
	}
</style>
