---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { images } from "@/lib/images";
import { withBase } from "@/lib/urls";
import Container from "@ui/Container.astro";

interface Props {
	service: any;
}

const { service } = Astro.props;

// ── Department image map (one per department) ──────────────────────────────
const deptImageMap: Record<string, string> = {
	neurology:   "../assets/neurology-hero.webp",
	orthopedics: "../assets/orthopedics-hero.webp",
	ortho:       "../assets/orthopedics-hero.webp",
	cardiology:  "../assets/cardiology-hero.webp",
	pediatric:   "../assets/pediatric-hero.webp",
	radiology:   "../assets/radiology-scanner.webp",
	laboratory:  "../assets/laboratory-hero.webp",
};
const imageKey    = deptImageMap[service.slug] ?? "../assets/equipment.webp";
const deptImage   = images[imageKey] ?? images["../assets/equipment.webp"] ?? images["../assets/service.webp"];

// ── Doctor slug map ────────────────────────────────────────────────────────
const doctorMap: Record<string, string> = {
	orthopedics: "david-miller",
	ortho:       "david-miller",
	cardiology:  "sarah-johnson",
	neurology:   "michael-chen",
	pediatric:   "elena-cruz",
	radiology:   "james-wilson",
	laboratory:  "amara-okoro",
};
const doctorSlug = doctorMap[service.slug];
let doctor: any = null;
if (doctorSlug) {
	const all = await getCollection("doctors");
	doctor = all.find((d) => d.slug === doctorSlug)?.data ?? null;
}

// ── Areas ──────────────────────────────────────────────────────────────────
const areas: Array<{ title: string; text: string; icon: string }> =
	service.sections?.areas?.items ?? [];

// ── Why choose us items ────────────────────────────────────────────────────
const whyItems: Array<{ icon: string; title: string; text: string; highlight?: string }> =
	service.sections?.whyChooseUs?.items?.slice(0, 4) ?? [
		{ icon: "care",      title: "Minimally Invasive Techniques",      text: "Smaller incisions, less tissue damage, faster healing — precision surgery for optimal outcomes." },
		{ icon: "safety",    title: "Natural Tissue Preservation",         text: "We preserve healthy structures to maximise longevity and maintain your body's natural function." },
		{ icon: "clock",     title: "Same-Day Recovery",                   text: "Advanced anaesthesia and pain protocols let most patients mobilise and go home the same day." },
		{ icon: "stetoscope",title: "Personalised Treatment Plans",        text: "Every care plan is built around your imaging, lifestyle goals, and long-term health outcomes." },
	];

// ── Care process steps ─────────────────────────────────────────────────────
const processSteps: Array<{ label: string; title: string; desc: string }> = [
	{
		label: "01",
		title: "In-Depth Consultation & Imaging",
		desc:  "Your specialist reviews your history, conducts a clinical exam, and orders precision imaging (MRI/CT/X-ray) to map the exact nature and extent of your condition.",
	},
	{
		label: "02",
		title: "Personalised Treatment Plan",
		desc:  "Using your diagnostic data, your care team designs a tailored evidence-based treatment path — selecting the least invasive, most effective approach for your anatomy.",
	},
	{
		label: "03",
		title: "Procedure & Same-Day Discharge",
		desc:  "Your procedure is performed with advanced minimally invasive techniques under expert anaesthesia. Most patients are walking and discharged within hours of completion.",
	},
	{
		label: "04",
		title: "Recovery & Ongoing Support",
		desc:  "Our clinical team follows up with you at every milestone — from physiotherapy to medication review — until you have fully returned to your daily routine.",
	},
];

// ── FAQs ───────────────────────────────────────────────────────────────────
const defaultFaqs: Record<string, Array<{ q: string; a: string }>> = {
	orthopedics: [
		{ q: "Who is a candidate for minimally invasive joint care?",          a: "Patients with joint stiffness, chronic pain, or sports injuries unresponsive to physiotherapy or injections are assessed for tissue-sparing surgical or non-surgical solutions." },
		{ q: "How quickly can I walk after treatment?",                         a: "With modern minimally invasive techniques and multimodal analgesia, most patients are ambulatory within hours and discharged the same day." },
		{ q: "What does post-treatment rehabilitation involve?",                a: "Our physiotherapy team begins guided mobility exercises from day one to safely restore your strength and range of motion." },
		{ q: "Do I need a referral to book a consultation?",                   a: "No referral is required. You can book directly with our orthopaedic team at your convenience." },
	],
	neurology: [
		{ q: "When should I see a neurologist for headaches?",                 a: "If headaches disrupt daily life, come with aura or numbness, or don't respond to standard treatment, a full neurological evaluation is recommended." },
		{ q: "What does a digital EEG or nerve conduction study involve?",     a: "These are non-invasive tests that record brain electrical activity and peripheral nerve signals with high accuracy and no discomfort." },
		{ q: "Can memory and cognitive decline be treated?",                   a: "Early diagnosis enables targeted medications, cognitive therapies, and lifestyle plans that meaningfully preserve independence." },
		{ q: "How quickly are acute neurological emergencies handled?",        a: "Our unit has a rapid-response protocol with immediate imaging and board-certified neurological assessment 24 / 7." },
	],
	cardiology: [
		{ q: "What happens during my first cardiovascular consultation?",       a: "You'll receive a full clinical review, digital ECG, blood pressure assessment, and on-site diagnostics to build your cardiac health baseline." },
		{ q: "How soon can I resume normal activity after treatment?",          a: "Most patients resume daily activities within 48–72 hours under our guided cardiac recovery protocols." },
		{ q: "Are emergency cardiac consultations available around the clock?", a: "Yes. Our chest-pain triage and acute cardiovascular emergency units operate 24 / 7 with rapid response." },
		{ q: "Do you offer preventive heart health screenings?",               a: "Yes — comprehensive panels including lipid profiles, calcium scoring, and treadmill stress tests." },
	],
	pediatric: [
		{ q: "What age range does CareFirst Pediatrics serve?",                 a: "We care for newborns, infants, children, and adolescents up to age 18." },
		{ q: "How do you help children feel at ease during visits?",            a: "Our child-friendly exam rooms, gentle staff, and play areas are designed to minimise clinical anxiety." },
		{ q: "Can I get a same-day sick appointment for my child?",             a: "Yes — we keep dedicated daily slots for fevers, acute illness, and urgent pediatric concerns." },
	],
	radiology: [
		{ q: "How quickly does my doctor receive imaging results?",             a: "Most scans (MRI, CT, Ultrasound, X-Ray) are interpreted within 2–4 hours and available via the patient portal." },
		{ q: "Are the imaging protocols low-radiation and safe?",              a: "Yes — we use ultra-low-dose digital protocols with shielding, maintaining maximum diagnostic resolution." },
		{ q: "How do I prepare for an MRI or CT scan?",                        a: "Our coordinators provide tailored preparation instructions depending on whether contrast is prescribed." },
	],
	laboratory: [
		{ q: "Do I need to fast before blood tests?",                          a: "Fasting (8–12 hours) is required for lipid panels, glucose, and metabolic screens. We confirm exact requirements at booking." },
		{ q: "How do I access my results?",                                    a: "Results are uploaded securely to the CareFirst Patient Portal and sent to your referring physician." },
		{ q: "Are walk-in appointments accepted?",                             a: "Yes — walk-ins are welcome during regular laboratory hours, Monday through Saturday." },
	],
};
const faqs = defaultFaqs[service.slug] ?? defaultFaqs.orthopedics;

// ── Dept name short form — use pageTitle (shorter) ────────────────────────
const deptName = (service.pageTitle as string ?? "")
	.replace(/<[^>]+>/g, "")
	.replace(/\s*\|.*$/, "")
	.trim();
---

<div class="sds-root">
	<Container>
		<div class="sds-layout">

			<!-- ══════════════════════════════════════════════════
			     LEFT: Long-form content column
			════════════════════════════════════════════════════ -->
			<main class="sds-main">

				<!-- ── 1. Department image ───────────────────── -->
				{deptImage && (
					<div class="dept-img-wrap">
						<Picture
							src={deptImage}
							alt={`CareFirst ${deptName} Department`}
							formats={["webp"]}
							widths={[720, 1080]}
							sizes="(max-width: 960px) 100vw, 720px"
							loading="eager"
							decoding="async"
							class="dept-img"
						/>
					</div>
				)}

				<!-- ── 2. Overview paragraph ─────────────────── -->
				<section class="content-block">
					<h2 class="block-heading">About This Service</h2>
					<p class="body-text">
						{service.sections?.hero?.subtitle ?? `At CareFirst Clinic, our ${deptName} department brings together fellowship-trained specialists, advanced diagnostics, and evidence-based treatment protocols to deliver outstanding patient outcomes.`}
					</p>
					<p class="body-text">
						We combine the highest clinical standards with a patient-first approach — minimising procedure complexity, reducing recovery time, and helping you return to full daily function as quickly as possible.
					</p>
				</section>

				<!-- ── 3. Specialty areas ────────────────────── -->
				{areas.length > 0 && (
					<section class="content-block">
						<h2 class="block-heading">{service.sections?.areas?.sectionHeader?.title ?? "Clinical Specialties"}</h2>
						<p class="body-text lead">{service.sections?.areas?.sectionHeader?.subtitle ?? "Our department covers a broad range of specialised clinical programmes."}</p>

						<ul class="area-list">
							{areas.map((area) => (
								<li class="area-item">
									<span class="area-check" aria-hidden="true">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="20 6 9 17 4 12"/>
										</svg>
									</span>
									<div class="area-body">
										<strong class="area-title">{area.title}</strong>
										<span class="area-desc">{area.text}</span>
									</div>
								</li>
							))}
						</ul>
					</section>
				)}

				<!-- ── 4. Why choose us ──────────────────────── -->
				<section class="content-block">
					<h2 class="block-heading">Why Choose CareFirst</h2>
					<p class="body-text lead">{service.sections?.whyChooseUs?.subtitle ?? "Our clinical standards, technology, and team set us apart."}</p>

					<div class="why-grid">
						{whyItems.map((item) => (
							<div class="why-card">
								<div class="why-icon">
									<Icon name={item.icon ?? "care"} />
								</div>
								<div class="why-body">
									{item.highlight && <span class="why-pill">{item.highlight}</span>}
									<h3 class="why-title">{item.title}</h3>
									<p class="why-text">{item.text}</p>
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- ── 5. Care process (numbered steps) ─────── -->
				<section class="content-block">
					<h2 class="block-heading">Your Care Journey — Step by Step</h2>
					<p class="body-text lead">From your first visit to full recovery, here is exactly what to expect.</p>

					<ol class="process-list">
						{processSteps.map((step) => (
							<li class="process-step">
								<div class="step-number" aria-hidden="true">{step.label}</div>
								<div class="step-body">
									<h3 class="step-title">{step.title}</h3>
									<p class="step-desc">{step.desc}</p>
								</div>
							</li>
						))}
					</ol>
				</section>

				<!-- ── 6. FAQ ─────────────────────────────────── -->
				<section class="content-block" id="faq">
					<h2 class="block-heading">Frequently Asked Questions</h2>

					<div class="faq-list">
						{faqs.map((faq, i) => (
							<details class="faq-item" open={i === 0}>
								<summary class="faq-summary">
									<span class="faq-q">{faq.q}</span>
									<span class="faq-chevron" aria-hidden="true">
										<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="6 9 12 15 18 9"/>
										</svg>
									</span>
								</summary>
								<p class="faq-answer">{faq.a}</p>
							</details>
						))}
					</div>
				</section>

			</main>

			<!-- ══════════════════════════════════════════════════
			     RIGHT: Sticky sidebar
			════════════════════════════════════════════════════ -->
			<aside class="sds-sidebar">

				<!-- Booking CTA card -->
				<div class="sidebar-card cta-card">
					<h3 class="cta-card-title">Book a Consultation</h3>
					<p class="cta-card-sub">Our specialists are ready to help you. Same-week appointments available.</p>
					<a href={withBase("/appointment")} class="cta-btn-primary">
						Schedule Your Visit
					</a>
					<a href="tel:+916239796319" class="cta-btn-phone">
						<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.47 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/>
						</svg>
						+91 62397 96319
					</a>

					<div class="cta-divider"></div>

					<ul class="trust-list">
						<li>
							<span class="trust-check" aria-hidden="true">✓</span>
							Board-certified specialists
						</li>
						<li>
							<span class="trust-check" aria-hidden="true">✓</span>
							Same-week appointments
						</li>
						<li>
							<span class="trust-check" aria-hidden="true">✓</span>
							Insurance assistance available
						</li>
						<li>
							<span class="trust-check" aria-hidden="true">✓</span>
							No referral required
						</li>
					</ul>
				</div>

				<!-- Doctor card -->
				{doctor && (
					<div class="sidebar-card doctor-card">
						<img
							src={doctor.image}
							alt={`Dr. ${doctor.name}`}
							class="doctor-photo"
							width="340"
							height="220"
							loading="lazy"
							decoding="async"
						/>
						<div class="doctor-info">
							<p class="doctor-name">Dr. {doctor.name}</p>
							<p class="doctor-role">{doctor.specialty ?? deptName + " Specialist"}</p>
							<div class="doctor-meta">
								<span class="meta-pill">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
									</svg>
									{doctor.rating ?? "4.9"} Rating
								</span>
								<span class="meta-pill">
									{doctor.experience ?? "10+"} Years
								</span>
							</div>
						</div>
						<a href={withBase(`/doctors/${doctorSlug}`)} class="doctor-link">
							View Full Profile
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"/>
								<polyline points="12 5 19 12 12 19"/>
							</svg>
						</a>
					</div>
				)}

				<!-- Quick info card -->
				<div class="sidebar-card info-card">
					<h4 class="info-card-title">Quick Facts</h4>
					<ul class="info-list">
						<li><span class="info-label">Department</span><span class="info-val">{deptName}</span></li>
						<li><span class="info-label">Availability</span><span class="info-val">Mon – Sat</span></li>
						<li><span class="info-label">Appointment</span><span class="info-val">Same-week</span></li>
						<li><span class="info-label">Technology</span><span class="info-val">Latest Equipment</span></li>
						<li><span class="info-label">Accreditation</span><span class="info-val">NABH Certified</span></li>
					</ul>
				</div>

			</aside>
		</div>
	</Container>
</div>

<style>
	/* ═══════════════════════════════════════════
	   Root wrapper
	═══════════════════════════════════════════ */
	.sds-root {
		background: #f5f7fa;
		padding-block: clamp(4rem, 3rem + 2vw, 6rem);
	}

	/* ═══════════════════════════════════════════
	   Two-column layout (content + sidebar)
	═══════════════════════════════════════════ */
	.sds-layout {
		display: grid;
		grid-template-columns: 1fr 34rem;
		gap: 3.2rem;
		align-items: start;

		@media (max-width: 1024px) {
			grid-template-columns: 1fr 30rem;
			gap: 2.4rem;
		}

		@media (max-width: 860px) {
			grid-template-columns: 1fr;
		}
	}

	/* ═══════════════════════════════════════════
	   MAIN (left column)
	═══════════════════════════════════════════ */
	.sds-main {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	/* Department image */
	.dept-img-wrap {
		border-radius: 1.6rem;
		overflow: hidden;
		margin-bottom: 3.2rem;
		box-shadow: 0 4px 24px -4px rgba(15, 23, 42, 0.1);
	}
	.dept-img {
		width: 100%;
		height: 42rem;
		object-fit: cover;
		display: block;

		@media (max-width: 640px) {
			height: 28rem;
		}
	}

	/* Content blocks */
	.content-block {
		background: #fff;
		border-radius: 1.6rem;
		padding: clamp(2.8rem, 2rem + 1.5vw, 4rem);
		margin-bottom: 2.4rem;
		border: 1px solid rgba(15, 23, 42, 0.07);

		&:last-child {
			margin-bottom: 0;
		}
	}

	.block-heading {
		font-family: var(--font-jakarta);
		font-size: clamp(2rem, 1.7rem + 0.8vw, 2.6rem);
		font-weight: 800;
		color: #0f172a;
		letter-spacing: -0.02em;
		margin: 0 0 1.6rem;
		line-height: 1.25;
		padding-bottom: 1.4rem;
		border-bottom: 2px solid rgba(29, 84, 199, 0.12);
	}

	.body-text {
		font-family: var(--font-manrope);
		font-size: clamp(1.55rem, 1.45rem + 0.2vw, 1.75rem);
		line-height: 1.72;
		color: #334155;
		margin: 0 0 1.4rem;

		&:last-child {
			margin-bottom: 0;
		}

		&.lead {
			color: #475569;
			margin-bottom: 2.4rem;
		}
	}

	/* ── Specialty areas list ──────────────────── */
	.area-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.area-item {
		display: flex;
		gap: 1.6rem;
		padding: 1.8rem 0;
		border-bottom: 1px solid rgba(15, 23, 42, 0.06);

		&:first-child {
			padding-top: 0;
		}
		&:last-child {
			border-bottom: none;
			padding-bottom: 0;
		}
	}

	.area-check {
		width: 2.8rem;
		height: 2.8rem;
		border-radius: 50%;
		background: rgba(29, 84, 199, 0.09);
		color: var(--color-primary);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		margin-top: 0.1rem;
	}

	.area-body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.area-title {
		font-family: var(--font-jakarta);
		font-size: 1.6rem;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.3;
	}

	.area-desc {
		font-family: var(--font-manrope);
		font-size: 1.45rem;
		line-height: 1.6;
		color: #64748b;
	}

	/* ── Why choose us grid ───────────────────── */
	.why-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.8rem;

		@media (max-width: 600px) {
			grid-template-columns: 1fr;
		}
	}

	.why-card {
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
		padding: 2.2rem 2rem;
		background: #f8fafc;
		border: 1px solid rgba(15, 23, 42, 0.07);
		border-radius: 1.4rem;
		transition: all 0.2s ease;

		&:hover {
			border-color: rgba(29, 84, 199, 0.25);
			background: #fff;
			box-shadow: 0 6px 18px -4px rgba(15, 23, 42, 0.07);
		}
	}

	.why-icon {
		width: 4.4rem;
		height: 4.4rem;
		border-radius: 1.2rem;
		background: rgba(29, 84, 199, 0.09);
		color: var(--color-primary);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 2rem;
	}

	.why-pill {
		display: inline-block;
		font-family: var(--font-jakarta);
		font-size: 1.1rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.3rem 0.9rem;
		background: rgba(29, 84, 199, 0.08);
		border-radius: 9999px;
		color: var(--color-primary);
		width: fit-content;
	}

	.why-title {
		font-family: var(--font-jakarta);
		font-size: 1.55rem;
		font-weight: 700;
		color: #0f172a;
		margin: 0;
		line-height: 1.3;
	}

	.why-text {
		font-family: var(--font-manrope);
		font-size: 1.4rem;
		line-height: 1.58;
		color: #475569;
		margin: 0;
	}

	/* ── Care process ─────────────────────────── */
	.process-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0;
		counter-reset: none;
	}

	.process-step {
		display: flex;
		gap: 2.4rem;
		align-items: flex-start;
		padding: 2.4rem 0;
		border-bottom: 1px solid rgba(15, 23, 42, 0.07);
		position: relative;

		&:last-child {
			border-bottom: none;
			padding-bottom: 0;
		}
		&:first-child {
			padding-top: 0;
		}
	}

	.step-number {
		font-family: var(--font-jakarta);
		font-size: 2.4rem;
		font-weight: 900;
		color: rgba(29, 84, 199, 0.18);
		line-height: 1;
		flex-shrink: 0;
		width: 4.8rem;
		letter-spacing: -0.04em;
		padding-top: 0.2rem;
	}

	.step-body {
		flex: 1;
	}

	.step-title {
		font-family: var(--font-jakarta);
		font-size: 1.7rem;
		font-weight: 700;
		color: #0f172a;
		margin: 0 0 0.8rem;
		line-height: 1.3;
	}

	.step-desc {
		font-family: var(--font-manrope);
		font-size: 1.5rem;
		line-height: 1.65;
