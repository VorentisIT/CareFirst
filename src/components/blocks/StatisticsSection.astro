---
import Section from "@ui/Section.astro";

interface Props {
	data: any;
}

const {
	data: { ...props },
} = Astro.props;

const isDepartment = props.config?.variant === "department";
---

<Section class={`section--primary ${isDepartment ? 'statistics-section--department' : ''}`} background={props.config?.background}>
	<div class={`statistics ${isDepartment ? 'statistics--cards' : ''}`}>
		{
			props.data.map((item: any) => (
				<div class={`stat-item ${isDepartment ? 'stat-item--card' : ''}`}>
					<span class="stat-amount" data-counter-val={item.amount}>{item.amount}</span>
					<span class="stat-caption">{item.caption}</span>
				</div>
			))
		}
	</div>
</Section>

<script>
	function initCounters() {
		const statElements = document.querySelectorAll<HTMLElement>(".stat-amount[data-counter-val]");
		if (!statElements.length) return;

		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						animateCounter(entry.target as HTMLElement);
						obs.unobserve(entry.target);
					}
				});
			},
			{
				threshold: 0.15,
			}
		);

		statElements.forEach((el) => {
			if (el.dataset.animated === "true") return;
			observer.observe(el);
		});
	}

	function animateCounter(el: HTMLElement) {
		const raw = el.getAttribute("data-counter-val") || el.textContent || "";
		const trimmed = raw.trim();
		const match = trimmed.match(/^([^\d]*)([\d]+(?:\.[\d]+)?)(.*)$/);

		if (!match) {
			// Non-numeric value (e.g. "Robotic", "Dedicated") - keep original text
			return;
		}

		el.dataset.animated = "true";

		const prefix = match[1];
		const targetNum = parseFloat(match[2]);
		const suffix = match[3];
		const decimals = match[2].includes(".") ? match[2].split(".")[1].length : 0;

		const duration = 1800;
		let startTime: number | null = null;

		function step(timestamp: number) {
			if (!startTime) startTime = timestamp;
			const elapsed = timestamp - startTime;
			const progress = Math.min(elapsed / duration, 1);

			// Ease-out cubic for smooth deceleration
			const easeProgress = 1 - Math.pow(1 - progress, 3);
			const currentVal = targetNum * easeProgress;

			const formattedNum =
				decimals > 0
					? currentVal.toFixed(decimals)
					: Math.floor(currentVal).toString();

			el.textContent = `${prefix}${formattedNum}${suffix}`;

			if (progress < 1) {
				requestAnimationFrame(step);
			} else {
				const finalNum = decimals > 0 ? targetNum.toFixed(decimals) : targetNum.toString();
				el.textContent = `${prefix}${finalNum}${suffix}`;
			}
		}

		// Initial display starting at 0
		const initialNum = decimals > 0 ? (0).toFixed(decimals) : "0";
		el.textContent = `${prefix}${initialNum}${suffix}`;

		requestAnimationFrame(step);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initCounters);
	} else {
		initCounters();
	}

	document.addEventListener("astro:page-load", initCounters);
</script>

<style>
	.statistics {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--global-gap);
		color: var(--color-white);

		@media screen and (max-width: 768px) {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8rem;
		padding: 0;
		text-align: center;
	}

	.stat-amount {
		font-size: clamp(3.2rem, calc(2.636rem + 2.818vw), 5.6rem);
		font-weight: 700;
		line-height: 1.1;
		color: var(--color-white);
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	.stat-caption {
		font-size: clamp(1.4rem, calc(1.318rem + 0.409vw), 1.8rem);
		color: rgba(255, 255, 255, 0.92);
		font-weight: 500;
	}

	/* Department Variant - "Little Different" Carded Design */
	:global(.statistics-section--department) {
		padding-block: clamp(2.4rem, 2.5vw, 3.4rem) !important;
	}

	.statistics--cards {
		gap: 2rem;

		@media screen and (max-width: 640px) {
			gap: 1.2rem;
		}
	}

	.stat-item--card {
		background: rgba(255, 255, 255, 0.10);
		border: 1px solid rgba(255, 255, 255, 0.20);
		border-radius: 1.6rem;
		padding: 2.8rem 1.6rem;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
		transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;

		&:hover {
			transform: translateY(-3px);
			background: rgba(255, 255, 255, 0.15);
			box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
		}

		.stat-amount {
			color: #ffffff;
			text-shadow: 0 2px 10px rgba(0, 0, 0, 0.15);
		}

		.stat-caption {
			color: rgba(255, 255, 255, 0.95);
		}

		@media screen and (max-width: 640px) {
			padding: 2rem 1.2rem;
		}
	}
</style>
