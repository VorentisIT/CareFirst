---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";

interface Props {
	data: any;
}

const {
	data: { ...props },
} = Astro.props;

const items = props.items || [];
---

<Section
	class={`values-section ${props.config?.class || ""}`}
	background={props.config?.background || "bg-1"}
	sectionHeader={props.sectionHeader}
>
	{
		items.length > 0 && (
			<div class="values-container">
				<div class="values-grid">
					{items.map((item: any) => (
						<article class="value-card">
							<div class="value-card__icon-box">
								<Icon name={item.icon} class="value-card__icon" />
							</div>

							<div class="value-card__content">
								<h3 class="value-card__title">{item.title}</h3>
								<p class="value-card__text">{item.text}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		)
	}
</Section>

<style>
	.values-section {
		position: relative;
	}

	.values-container {
		width: 100%;
		max-width: 120rem;
		margin: 0 auto;
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2.8rem;
		margin-top: 4.8rem;

		@media (max-width: 860px) {
			grid-template-columns: 1fr;
			gap: 2rem;
			margin-top: 3.6rem;
		}
	}

	.value-card {
		background: #ffffff;
		border: 1px solid rgba(15, 23, 42, 0.08);
		border-radius: 2rem;
		padding: clamp(2.8rem, 2.4rem + 1vw, 3.6rem);
		display: flex;
		flex-direction: column;
		gap: 1.8rem;
		box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
	}

	.value-card__icon-box {
		width: 5.2rem;
		height: 5.2rem;
		border-radius: 1.4rem;
		background: rgba(29, 84, 199, 0.08);
		border: 1px solid rgba(29, 84, 199, 0.12);
		color: var(--color-primary);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.value-card__icon {
		width: 2.6rem;
		height: 2.6rem;
	}

	.value-card__content {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.value-card__title {
		font-family: var(--font-jakarta);
		font-size: clamp(2rem, 1.8rem + 0.4vw, 2.3rem);
		font-weight: 800;
		color: #0f172a;
		letter-spacing: -0.015em;
		line-height: 1.3;
		margin: 0;
	}

	.value-card__text {
		font-family: var(--font-manrope);
		font-size: 1.55rem;
		line-height: 1.7;
		color: #475569;
		margin: 0;
	}
</style>
