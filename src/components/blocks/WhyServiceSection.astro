---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";

interface Props {
	data: any;
}

const {
	data: { ...props },
} = Astro.props;

if (!props || !props.items) return null;
---

<Section class="section--why-service" background={props.config?.background || "bg-1"}>
	<div class="why-header">
		{props.badge && <span class="why-badge">{props.badge}</span>}
		{props.title && <h2 class="why-title" set:html={props.title} />}
		{props.subtitle && <p class="why-subtitle">{props.subtitle}</p>}
	</div>

	<div class="why-grid">
		{
			props.items.map((item: any, idx: number) => (
				<div class="why-card">
					<div class="why-card__top">
						<span class="why-card__icon">
							<Icon name={item.icon || "safety"} />
						</span>
						<span class="why-card__step">0{idx + 1}</span>
					</div>
					<h3 class="why-card__title">{item.title}</h3>
					<p class="why-card__text">{item.text}</p>
					{item.highlight && (
						<div class="why-card__highlight">
							<span class="highlight-dot"></span>
							<span>{item.highlight}</span>
						</div>
					)}
				</div>
			))
		}
	</div>
</Section>

<style>
	.why-header {
		text-align: center;
		max-width: 76rem;
		margin-inline: auto;
		margin-bottom: 4.8rem;
	}

	.why-badge {
		display: inline-block;
		font-size: 1.2rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		padding: 0.5rem 1.6rem;
		background: rgba(30, 86, 160, 0.08);
		border: 1px solid rgba(30, 86, 160, 0.2);
		border-radius: 9999px;
		color: var(--color-primary);
		margin-bottom: 1.2rem;
	}

	.why-title {
		font-size: clamp(2.8rem, calc(2.4rem + 1.2vw), 4rem);
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-dark, #1a202c);
		margin: 0 0 1.2rem;
	}

	.why-subtitle {
		font-size: clamp(1.5rem, calc(1.4rem + 0.3vw), 1.8rem);
		color: #4a5568;
		line-height: 1.6;
		margin: 0;
	}

	.why-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2.4rem;

		@media screen and (max-width: 1024px) {
			grid-template-columns: repeat(2, 1fr);
		}

		@media screen and (max-width: 640px) {
			grid-template-columns: 1fr;
			gap: 1.6rem;
		}
	}

	.why-card {
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 1.8rem;
		padding: 3rem 2.4rem;
		display: flex;
		flex-direction: column;
		transition: all 0.25s ease;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
		position: relative;

		&:hover {
			transform: translateY(-4px);
			border-color: var(--color-primary);
			box-shadow: 0 12px 28px rgba(30, 86, 160, 0.12);
		}
	}

	.why-card__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.why-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 5.2rem;
		height: 5.2rem;
		background: #eef6ff;
		color: var(--color-primary);
		border-radius: 1.4rem;
		font-size: 2.4rem;
	}

	.why-card__step {
		font-size: 1.4rem;
		font-weight: 800;
		color: #cbd5e1;
		letter-spacing: 0.05em;
	}

	.why-card__title {
		font-size: 1.9rem;
		font-weight: 700;
		color: #1a202c;
		margin: 0 0 1rem;
		line-height: 1.3;
	}

	.why-card__text {
		font-size: 1.45rem;
		line-height: 1.6;
		color: #4a5568;
		margin: 0 0 1.6rem;
		flex-grow: 1;
	}

	.why-card__highlight {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-primary);
		padding-top: 1.2rem;
		border-top: 1px dashed #e2e8f0;
	}

	.highlight-dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background-color: var(--color-primary);
	}
</style>
