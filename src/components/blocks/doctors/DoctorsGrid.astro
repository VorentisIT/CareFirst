---
import { withBase } from "@/lib/urls";
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import Button from "@ui/Button.astro";

export interface Doctor {
	name: string;
	specialty: string;
	department?: string;
	credentials?: string;
	availability?: string;
	availableNow?: boolean;
	rating: number;
	reviewsCount?: number;
	languages?: string[];
	image: string;
	profileUrl: string;
	appointmentUrl: string;
}

interface Props {
	data: any;
}

const {
	data: { ...props },
} = Astro.props;

const categories = props.categories || ["All", "Cardiology", "Neurology", "Pediatrics", "Orthopedics", "Dermatology"];
const doctors = (props.doctorsList || []) as Doctor[];
---

<Section
	class={`doctors-section ${props.config?.class || ""}`}
	background={props.config?.background || "bg-2"}
	sectionHeader={props.sectionHeader}
>
	<!-- Trust Highlights Bar -->
	<div class="doctors-trust-bar">
		<div class="doctors-trust-item">
			<div class="doctors-trust-icon">
				<Icon name="safety" />
			</div>
			<div>
				<strong>100% Board-Certified</strong>
				<span>Fully verified clinical leaders</span>
			</div>
		</div>

		<div class="doctors-trust-item">
			<div class="doctors-trust-icon">
				<Icon name="clock" />
			</div>
			<div>
				<strong>Fast Appointments</strong>
				<span>Same-day & next-day slots</span>
			</div>
		</div>

		<div class="doctors-trust-item">
			<div class="doctors-trust-icon">
				<Icon name="care" />
			</div>
			<div>
				<strong>Collaborative Care</strong>
				<span>Multi-specialty referrals</span>
			</div>
		</div>
	</div>

	<!-- Doctors Grid -->
	<div class="doctors-grid" id="doctors-grid">
		{
			doctors.map((doctor: Doctor) => (
				<article
					class="doctor-card"
					data-doctor-card
					data-department={doctor.department || doctor.specialty}
					data-name={doctor.name.toLowerCase()}
					data-specialty={doctor.specialty.toLowerCase()}
				>
					<div class="doctor-card__image-wrap">
						<a
							href={withBase(doctor.profileUrl)}
							class="doctor-card__image-link"
							aria-label={`View profile for ${doctor.name}`}
						>
							<img
								src={doctor.image}
								alt={`${doctor.name}, ${doctor.specialty}`}
								width="400"
								height="320"
								loading="lazy"
								decoding="async"
								class="doctor-card__img"
							/>
						</a>
					</div>

					<div class="doctor-card__content">
						<div class="doctor-card__header">
							<div class="doctor-card__title-row">
								<h3 class="doctor-card__name">
									<a href={withBase(doctor.profileUrl)} class="doctor-card__name-link">
										{doctor.name}
									</a>
								</h3>
								{doctor.availability && (
									<div class={`doctor-card__availability ${doctor.availableNow ? "is-now" : ""}`}>
										<span class="availability-dot" />
										<span>{doctor.availability}</span>
									</div>
								)}
							</div>
							<p class="doctor-card__specialty">{doctor.specialty}</p>
						</div>

						{doctor.credentials && (
							<p class="doctor-card__credentials">{doctor.credentials}</p>
						)}

						{doctor.languages && (
							<div class="doctor-card__meta-tags">
								<span class="doctor-card__lang-label">Languages:</span>
								{doctor.languages.map((lang: string) => (
									<span class="doctor-card__lang-pill">{lang}</span>
								))}
							</div>
						)}

						<div class="doctor-card__actions">
							<Button
								href={withBase(doctor.appointmentUrl)}
								variant="solid"
								color="primary"
								class="doctor-card__btn doctor-card__btn--primary"
							>
								Book Appointment
							</Button>
							<Button
								href={withBase(doctor.profileUrl)}
								variant="outline"
								color="primary"
								class="doctor-card__btn"
							>
								View Profile
							</Button>
						</div>
					</div>
				</article>
			))
		}
	</div>
</Section>

<style>
	.doctors-section {
		position: relative;
	}

	/* Trust Highlights */
	.doctors-trust-bar {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--global-gap);
		background: var(--color-white);
		border: 1px solid var(--color-card-border);
		border-radius: 2rem;
		padding: 2.4rem 3.2rem;
		margin-bottom: 4rem;
		box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);

		@media screen and (max-width: 900px) {
			grid-template-columns: 1fr;
			gap: 1.6rem;
			padding: 2rem;
		}
	}

	.doctors-trust-item {
		display: flex;
		align-items: center;
		gap: 1.6rem;

		strong {
			display: block;
			font-family: var(--font-jakarta);
			font-size: 1.6rem;
			color: var(--color-title);
			font-weight: 700;
		}

		span {
			display: block;
			font-size: 1.35rem;
			color: var(--color-muted);
		}
	}

	.doctors-trust-icon {
		width: 4.8rem;
		height: 4.8rem;
		border-radius: 1.4rem;
		background: rgba(29, 84, 199, 0.08);
		color: var(--color-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2.2rem;
		flex-shrink: 0;

		:global(svg) {
			width: 2.4rem;
			height: 2.4rem;
		}
	}

	/* Grid Layout */
	.doctors-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--global-gap);
		margin-top: 0;

		@media screen and (max-width: 1024px) {
			grid-template-columns: repeat(2, 1fr);
		}

		@media screen and (max-width: 768px) {
			grid-template-columns: 1fr;
		}
	}

	/* Doctor Card */
	.doctor-card {
		display: flex;
		flex-direction: column;
		background: var(--color-white);
		border: 1px solid var(--color-card-border);
		border-radius: 2.4rem;
		overflow: hidden;
		box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
			border-color 0.4s ease,
			box-shadow 0.4s ease;

		&:hover {
			border-color: rgba(29, 84, 199, 0.4);
			box-shadow: 0 16px 40px rgba(29, 84, 199, 0.12), 0 2px 8px rgba(15, 23, 42, 0.04);
			transform: translateY(-6px);

			.doctor-card__img {
				transform: scale(1.04);
			}
		}
	}

	.doctor-card__image-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 4.8;
		min-height: 34rem;
		background: #f1f5f9;
		overflow: hidden;

		@media screen and (max-width: 768px) {
			aspect-ratio: 4 / 4.6;
			min-height: 32rem;
			max-height: 46rem;
		}
	}

	.doctor-card__image-link {
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
	}

	.doctor-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.doctor-card__availability {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.35rem 0.95rem;
		border-radius: 9999px;
		background: rgba(15, 23, 42, 0.88);
		color: #ffffff;
		font-size: 1.15rem;
		font-weight: 600;
		line-height: 1.2;
		white-space: nowrap;
		flex-shrink: 0;

		&.is-now {
			background: #10b981;
			color: #ffffff;

			.availability-dot {
				background: #ffffff;
				box-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
			}
		}
	}

	.availability-dot {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 6px #10b981;
		flex-shrink: 0;
	}

	.doctor-card__content {
		display: flex;
		flex-direction: column;
		padding: 2.4rem 2rem;
		gap: 1.6rem;
		flex-grow: 1;
	}

	.doctor-card__header {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.doctor-card__title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		flex-wrap: nowrap;
	}

	.doctor-card__name {
		font-family: var(--font-jakarta);
		font-size: 1.95rem;
		font-weight: 800;
		color: var(--color-title);
		line-height: 1.2;
		margin: 0;
		min-width: 0;
	}

	.doctor-card__name-link {
		color: inherit;
		text-decoration: none;
		transition: color 0.25s ease;

		&:hover {
			color: var(--color-primary);
		}
	}

	.doctor-card__specialty {
		font-size: 1.55rem;
		color: var(--color-primary);
		font-weight: 700;
		margin: 0;
	}

	.doctor-card__credentials {
		font-size: 1.35rem;
		color: var(--color-muted);
		font-weight: 600;
		margin: 0;
	}

	.doctor-card__meta-tags {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.doctor-card__lang-label {
		font-size: 1.25rem;
		color: var(--color-muted);
	}

	.doctor-card__lang-pill {
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--color-text);
		background: #f1f5f9;
		padding: 0.2rem 0.8rem;
		border-radius: 0.6rem;
	}

	.doctor-card__actions {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: auto;
		padding-top: 1rem;
	}

	.doctor-card__btn {
		width: 100%;
		justify-content: center;
	}

	/* Empty State */
	.doctors-empty {
		text-align: center;
		padding: 6rem 2rem;
		background: var(--color-white);
		border: 1px dashed var(--color-card-border);
		border-radius: 2.4rem;
		max-width: 60rem;
		margin: 0 auto;

		h3 {
			font-family: var(--font-jakarta);
			font-size: 2.4rem;
			color: var(--color-title);
			margin: 1.6rem 0 0.8rem;
		}

		p {
			color: var(--color-muted);
			font-size: 1.6rem;
			line-height: 1.6;
			margin: 0 0 2.4rem;
		}
	}

	.doctors-empty__icon {
		width: 6.4rem;
		height: 6.4rem;
		border-radius: 50%;
		background: rgba(29, 84, 199, 0.08);
		color: var(--color-primary);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 3rem;

		:global(svg) {
			width: 3.2rem;
			height: 3.2rem;
		}
	}

</style>
