---
import { Image } from "astro:assets";
import logoImg from "../../assets/carefirst-logo.png";
import { withBase } from "@/lib/urls";
import siteConfig from "../../siteConfig";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<a href={withBase("/")} class:list={["logo", className]} aria-label={siteConfig.name}>
	<Image
		src={logoImg}
		alt={siteConfig.name}
		class="logo__img"
		width={160}
		format="webp"
		quality={90}
		loading="eager"
		decoding="async"
	/>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		line-height: 1;
		flex-shrink: 0;
	}

	.logo__img {
		display: block;
		height: 4.2rem;
		max-height: 42px;
		width: auto;
		max-width: 16rem;
		object-fit: contain;
		transition: height 0.25s ease;
	}

	:global(.header--scrolled) .logo .logo__img,
	:global(.header--scrolled) .logo__img {
		height: 3.4rem;
		max-height: 34px;
	}

	@media screen and (max-width: 1024px) {
		.logo__img {
			height: 3.8rem;
			max-height: 38px;
			max-width: 14rem;
		}
	}

	@media screen and (max-width: 640px) {
		.logo__img {
			height: 3.4rem;
			max-height: 34px;
			max-width: 13rem;
		}

		:global(.header--scrolled) .logo .logo__img,
		:global(.header--scrolled) .logo__img {
			height: 3.0rem;
			max-height: 30px;
		}
	}
</style>
