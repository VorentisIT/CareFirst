---
import { withBase } from "@/lib/urls";
import siteConfig from "../../siteConfig";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<a href={withBase("/")} class:list={["logo", className]} aria-label={siteConfig.name}>
	<img
		src={withBase("/images/carefirst-logo.png")}
		alt={siteConfig.name}
		class="logo__img"
		loading="eager"
		decoding="sync"
	/>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		line-height: 1;
		flex-shrink: 0;
	}

	.logo__img {
		display: block;
		height: 5.4rem;
		max-height: 54px;
		width: auto;
		max-width: 22rem;
		object-fit: contain;
		transition: height 0.3s ease;
	}

	:global(.header--scrolled) .logo .logo__img,
	:global(.header--scrolled) .logo__img {
		height: 4.2rem;
		max-height: 42px;
	}

	@media screen and (max-width: 1024px) {
		.logo__img {
			height: 4.8rem;
			max-height: 48px;
		}
	}

	@media screen and (max-width: 640px) {
		.logo__img {
			height: 4.2rem;
			max-height: 42px;
		}

		:global(.header--scrolled) .logo .logo__img,
		:global(.header--scrolled) .logo__img {
			height: 3.8rem;
			max-height: 38px;
		}
	}
</style>
