---
import "../styles/global.css";
import { SEO } from "astro-seo";
import { Font } from "astro:assets";
import Header from "@components/blocks/Header.astro";
import Footer from "@components/blocks/Footer.astro";
import siteConfig from "@/siteConfig";

export interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = "CareFirst Clinic — Leading specialist healthcare clinic in Ludhiana, Punjab. Comprehensive medical departments, diagnostic imaging, and compassionate patient care.",
	image = "/og-image.jpg",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://carefirst.vorentis-it.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageURL = new URL(image, siteUrl).toString();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#1d54c7" />

		<Font cssVariable="--font-jakarta" preload />
		<Font cssVariable="--font-manrope" preload />

		<SEO
			title={title}
			description={description}
			canonical={canonicalURL}
			openGraph={{
				basic: {
					title: title,
					type: "website",
					image: ogImageURL,
					url: canonicalURL,
				},
				optional: {
					siteName: siteConfig.name,
					description: description,
				},
				image: {
					alt: "CareFirst Clinic - Medical Specialists & Advanced Healthcare",
					width: 1200,
					height: 630,
					type: "image/jpeg",
				},
			}}
			twitter={{
				card: "summary_large_image",
				site: "@carefirst",
				creator: "@vorentis_it",
				title: title,
				description: description,
				image: ogImageURL,
				imageAlt: "CareFirst Clinic - Medical Specialists & Advanced Healthcare",
			}}
		/>

		<!-- Fallback meta tags for instant social share previews (WhatsApp, iMessage, LinkedIn, Telegram, Facebook) -->
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:secure_url" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta name="twitter:image" content={ogImageURL} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<Header />
		<main id="main-content" class="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
