---
import "../../styles/global.css";
import Layout from "@layouts/Layout.astro";
import HeroSection from "@/components/blocks/HeroSection.astro";
import StatisticsSection from "@/components/blocks/StatisticsSection.astro";
import ServiceDetailSection from "@/components/blocks/ServiceDetailSection.astro";
import CtaSection from "@/components/blocks/CtaSection.astro";

export function getStaticPaths() {
	const modules = import.meta.glob("../../content/services/*.json", {
		eager: true,
		import: "default",
	});

	return Object.values(modules).map((service: any) => ({
		params: {
			slug: service.slug,
		},
		props: {
			service,
		},
	}));
}

const { service } = Astro.props;
---

<Layout
	title={service.pageTitle}
	description={`${service.pageTitle} at CareFirst Clinic. Specialized diagnostics, consultations, and personalized care.`}
>
	{service.sections.hero && <HeroSection data={service.sections.hero} />}
	{
		service.sections.statistics && (
			<StatisticsSection data={service.sections.statistics} />
		)
	}
	<ServiceDetailSection service={service} />
	{service.sections.cta && <CtaSection data={service.sections.cta} />}
</Layout>
